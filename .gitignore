# ============================================================================
#  Sign Language Recognition — .gitignore
#  Commit code, tests, docs, dataset metadata and JSON/PNG reports.
#  Ignore large, regenerable or personal data (videos, landmark arrays, weights).
# ============================================================================

# ── Raw source videos (personal video data — never commit, back up separately) ──
dataset/
excluded_clips/

# ── Generated by the pipeline (regenerate with python -m signlang <command>) ──
observation/                       # signlang observe
artifacts/logs/                    # train / finetune logs
artifacts/predictions/sessions/    # live-mode session logs
artifacts/predictions/*_pred.json  # per-video predictions (regenerable)
!artifacts/predictions/good_03_pred.json   # kept: record of the original run

# ── Video files anywhere (skeletons, overlays, predictions) ──
*.mp4
*.mov
*.avi
*.mkv
*.m4v
*.wmv
*.webm

# ── Landmark arrays ──
*.npy
*.npz

# ── Model weights / exported models (regenerable; back up separately) ──
*.pt
*.pth
*.ckpt
*.onnx

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtual environments ──
.venv/
.venv-*/
venv/
env/
ENV/

# ── Editors / OS ──
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ── Logs / scratch ──
*.log
scratchpad/
tmp/

# ── Claude Code local-only settings ──
.claude/settings.local.json
