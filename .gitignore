# ============================================================================
#  Sign-Language Landmark Pipeline — .gitignore
#  Commit the CODE, LOGIC, PIPELINE and DOCS.
#  Ignore large / regenerable DATA and VIDEO (re-create by running the scripts).
# ============================================================================

# ── Raw source videos (large binaries — back these up separately, NOT in git) ──
data/dataset/
data/excluded_clips/
data/samples/

# ── Everything the pipeline generates (regenerate with the scripts) ──
#    src/dataprep/extract_dataset.py -> data/processed_dataset/  (kept, minus videos/arrays)
#    src/dataprep/observe_video.py   -> data/observation/

data/observation/

# ── Training pipeline outputs (regenerate: train.py / finetune.py / export) ──
#    artifacts/: checkpoints, exported ONNX, metrics, predictions, caches, live temp, logs
#    (weights/logs are caught by the *.pt / *.onnx / *.log patterns below;
#     small JSON/PNG summaries stay in git)


# ── Standalone / output video files anywhere (skeletons, overlays, samples) ──
*.mp4
*.mov
*.avi
*.mkv
*.m4v
*.wmv
*.webm

# ── Bulk landmark arrays, if ever produced outside the ignored folders ──
*.npy
*.npz

# ── Trained model weights (regenerable; back up separately, NOT in git) ──
*.pt
*.pth
*.onnx

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── Editors / OS cruft ──
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ── Logs / scratch ──
*.log
scratchpad/
tmp/

# ── Claude Code local-only settings (keep shared .claude/settings.json) ──
.claude/settings.local.json

# ============================================================================
#  KEPT IN GIT (for reference — these are NOT ignored):
#    src/**/*.py                   all dataprep + training + inference code
#    data/processed_dataset/       landmark metadata, manifests, reports (no videos/arrays)
#    artifacts/                    small JSON/PNG summaries (no weights)
#    docs/dataprep/  docs/training/   *.md, diagrams/*.png, build scripts, PDFs
#    requirements.txt  requirements-dev.txt  .gitignore
# ============================================================================
